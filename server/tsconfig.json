{
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node",
      "express",
      "jest"
    ],
    "outDir": "./dist"
  },
  "include": [
    "src",
    "server/**/*.ts",
    "tests/**/*.ts"
  ]
}