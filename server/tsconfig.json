{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2022"
    ],
    "allowJs": false,
    "checkJs": false,
    "removeComments": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node",
      "express",
      "jest"
    ],
    "outDir": "./dist"
  },
  "include": [
    "src",
    "server/**/*.ts",
    "tests/**/*.ts"
  ]
}