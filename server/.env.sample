# .env.sample - Sample Environment Variables

# Application Configuration
APP_PORT=3310
APP_SECRET=YOUR_APP_SECRET_KEY

# Database Configuration for aiven
NODE_ENV=development
PORT=3000
DB_HOST=YOUR_AIVEN_DB_HOST
DB_PORT=YOUR_AIVEN_DB_PORT
DB_USER=YOUR_AIVEN_DB_USERNAME
DB_PASSWORD=YOUR_AIVEN_DB_PASSWORD
DB_NAME=YOUR_AIVEN_DB_NAME
DB_SSL=YOUR_AIVEN_DB_SSL_SETTING
