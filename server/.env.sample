# .env.sample - Sample Environment Variables

# Application Configuration
APP_PORT=3310
APP_SECRET=YOUR_APP_SECRET_KEY

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_NAME=YOUR_DATABASE_NAME

# Database Configuration for aiven
NODE_ENV=development
PORT=3000
DB_HOST=YOUR_AIVEN_DB_HOST
DB_PORT=YOUR_AIVEN_DB_PORT
DB_USER=YOUR_AIVEN_DB_USERNAME
DB_PASSWORD=YOUR_AIVEN_DB_PASSWORD
DB_NAME=YOUR_AIVEN_DB_NAME
DB_SSL=YOUR_AIVEN_DB_SSL_SETTING

# Client URL (for CORS configuration)
CLIENT_URL=http://localhost:3000

# Pour tout besoin spécifique, veuillez vous renseigner auprès de votre formateur concernant le nom du projet de déploiement et suivre le modèle.
# Vous pouvez ajouter autant de variables que nécessaire. N'oubliez pas d'en informer votre formateur. Dans le cas contraire, le déploiement pourrait échouer.
PROJECT_NAME_SPECIFIC_NAME=YOUR_SPECIFIC_VALUE
