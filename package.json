{
  "name": "jinloup-ludo-art",
  "version": "0.0.1",
  "description": "",
  "homepage": "https://github.com/G-Ludovic/Jinloup_Ludo_Art-v2#readme",
  "bugs": {
    "url": "https://github.com/G-Ludovic/Jinloup_Ludo_Art-v2/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/G-Ludovic/Jinloup_Ludo_Art-v2.git"
  },
  "workspaces": ["client", "server"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:render": "npm install --workspace=@js-monorepo/server",
    "check": "biome check --error-on-warnings --no-errors-on-unmatched --staged . && npm run check-types --workspaces --if-present",
    "check:fix": "biome check --write --error-on-warnings --no-errors-on-unmatched --staged .",
    "clean": "node ./bin/clean",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "dev": "concurrently -c green,yellow -t \"HH:mm:ss\" -p \"{name} {time}\" \"npm:dev:*\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "prepare": "git config core.hooksPath .git-hooks || true",
    "start": "npm run start --workspace=server",
    "test": "npm run test --workspaces --if-present",
    "security:check": "npm audit --omit=dev && npm ls form-data jws"
  },
  "keywords": [],
  "author": "G-Ludovic",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "concurrently": "^9.1.2",
    "validate-branch-name": "^1.3.2"
  },
  "dependencies": {
    "form-data": "^4.0.5"
  },
  "overrides": {
    "form-data": "^4.0.5",
    "jws": ">=3.2.3",
    "shell-quote": ">=1.8.4",
    "js-yaml": ">=4.2.0",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": ">=4.2.0"
    }
  }
}
